# Frontend build-time configuration
# Note: This file is only needed at the root for docker-compose to pass
# build args to the frontend container. The actual .env file should be
# in the frontend/ directory.
#
# For local development: Copy frontend/.env.local to frontend/.env
# For production: The deploy script auto-creates frontend/.env
#
# API Configuration - Full URL including /api/v0 path
# Development: VITE_API_URL=http://localhost:8000/api/v0
# Production: VITE_API_URL=https://your-domain.com/api/v0
VITE_API_URL=http://localhost:8000/api/v0

# Environment
VITE_ENV=development
