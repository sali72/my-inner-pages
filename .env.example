# ─────────────────────────────────────────────────────────────────────────────
# My Inner Pages — single environment file for the whole monorepo.
#
# Copy to `.env` at the repo root. There is deliberately NO .env in backend/
# or frontend/ — both read this one file:
#   - backend  → pydantic-settings, anchored to the repo root (app/*/config.py)
#   - frontend → Vite, via `envDir: '..'` in frontend/vite.config.ts
#
# Only VITE_*-prefixed vars are inlined into the public client bundle. Every
# other var below stays server-side. Never prefix a secret with VITE_.
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=development

# App version — auto-set from git tag in make backend/make run and in production deploy.
# Only needed here if running the backend standalone (uv run) or via docker compose.
APP_VERSION=0.2.0

# MongoDB Configuration
# if enabled MongoDB auth (--auth flag) use:
# MONGO_URL=mongodb://app_user:<password>@mongodb:27017/journaling_db?authSource=journaling_db
MONGO_URL=mongodb://mongodb:27017
DATABASE_NAME=journaling_db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production

# AI Module Configuration
USE_MOCK_LLM=false

CORS_ALLOWED_ORIGINS=["http://localhost:5173"]
CORS_ALLOW_CREDENTIALS=true

# Provider API Keys (referenced by MongoDB LLMProvider configurations)
OPENROUTER_API_KEY=your-openrouter-api-key-here
# GROQ_API_KEY=your-groq-api-key-here

# LLM Settings (optional - defaults provided)
# LLM_MAX_TOKENS=500
# LLM_TEMPERATURE=0.7

# Mirror Settings (optional - defaults provided)
# MAX_JOURNALS_FOR_MIRROR=10
# ENABLE_MIRROR=true

# Chat Settings (optional - defaults provided)
# CHAT_MAX_TOKENS=1000
# CHAT_TEMPERATURE=0.7
# MAX_JOURNALS_FOR_CHAT_CONTEXT=10

# Resend Configuration (email sending)
# RESEND_API_KEY=re_your-api-key

# Email Configuration
FROM_EMAIL=support@innerpages.ir
VERIFICATION_URL_BASE=http://localhost:5173?verify=

# Redis Configuration (for token blacklisting & rate limiting)
# REDIS_URL=redis://:password@redis:6379/0

# Google OAuth Configuration
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=your-client-secret
# GOOGLE_REDIRECT_URI=http://localhost:5173/api/v0/auth/google/callback
# FRONTEND_URL=http://localhost:5173

# Sentry Error Monitoring (optional — leave empty to disable)
# SENTRY_DSN=https://your-dsn@your-org.ingest.us.sentry.io/project-id

# Local Dev with Ollama can be added dynamically via the LLM Admin view

# Cloudflare Pages / Worker Proxy (server-side variable on Cloudflare)
# Set in Cloudflare Dashboard -> Settings -> Environment Variables
# BACKEND_ORIGIN=https://innerpages.ir

# ─── Frontend (VITE_*) ───────────────────────────────────────────────────────
# These are read at build time and inlined into the client bundle — public.

# Full URL including /api/v0 path. Defaults to http://localhost:8000/api/v0.
# In production on Cloudflare Pages, set to relative path /api/v0.
VITE_API_URL=http://localhost:8000/api/v0

VITE_ENV=development

# Sentry Error Monitoring (optional — leave empty to disable)
# VITE_SENTRY_DSN=https://your-dsn@your-org.ingest.us.sentry.io/project-id

