# API Configuration
# Full URL including /api/v0 path
VITE_API_URL=http://localhost:8000/api/v0

# WebSocket URL for chat (omit /api/v0 path, appended automatically)
VITE_WS_URL=ws://localhost:8000/api/v0

# Environment
VITE_ENV=development

# Sentry Error Monitoring (optional — leave empty to disable)
# VITE_SENTRY_DSN=https://your-dsn@your-org.ingest.us.sentry.io/project-id
