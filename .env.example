ENVIRONMENT=development

# MongoDB Configuration
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=journaling_db

# JWT Configuration
JWT_SECRET_KEY=your-secret-key-change-in-production

# AI Module Configuration
OPENROUTER_API_KEY=your-openrouter-api-key-here
USE_MOCK_LLM=false

# LLM Settings (optional - defaults provided)
LLM_MODEL=deepseek/deepseek-chat-v3.1:free
LLM_FALLBACK_MODELS=["meta-llama/llama-3.1-8b-instruct:free","google/gemini-flash-1.5:free"]
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MAX_TOKENS=500
# LLM_TEMPERATURE=0.7

# Mirror Settings (optional - defaults provided)
# MAX_JOURNALS_FOR_MIRROR=10
# ENABLE_MIRROR=true